# Gemini API — get free key at aistudio.google.com (no credit card needed)
GEMINI_API_KEY=

# PostgreSQL — auto-provided by Docker Compose
DATABASE_URL=postgresql://postgres:password@db:5432/aegisops

# Redis — auto-provided by Docker Compose
REDIS_URL=redis://redis:6379

# Prometheus — auto-provided by Docker Compose
PROMETHEUS_URL=http://prometheus:9090

# Set to true on demo day to use cached Gemini responses (eliminates rate limit risk)
DEMO_MODE=false

# Isolation Forest contamination rate (0.05 = flag top 5% of readings as anomalies)
ANOMALY_CONTAMINATION=0.05

# Prometheus polling interval in seconds
POLL_INTERVAL_SECONDS=30
